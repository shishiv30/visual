  "venues": {
    "venue_green_groomer": {
      "id": "venue_green_groomer",
      "terrain": "green",
      "name": {
        "zh": "绿道平整雪道",
        "en": "Green groomer"
      },
      "desc": {
        "zh": "空、缓、人少的绿道，先把刹车练稳。",
        "en": "Quiet, easy green groomer; own the brake first."
      },
      "tips": {
        "zh": "选最缓的坡，避开冰面和拥挤出口。",
        "en": "Pick the gentlest pitch; avoid ice and crowded runouts."
      }
    },
    "venue_blue_groomer": {
      "id": "venue_blue_groomer",
      "terrain": "blue",
      "name": {
        "zh": "蓝道平整雪道",
        "en": "Blue groomer"
      },
      "desc": {
        "zh": "中等坡平整道，适合平行、搓雪和大弯。",
        "en": "Moderate groomed blue; for parallel, skids, and long-radius carve."
      },
      "tips": {
        "zh": "人少、雪软一点更好；冰面减小弯深。",
        "en": "Prefer fewer people and softer snow; shallower turns on ice."
      }
    },
    "venue_red_piste": {
      "id": "venue_red_piste",
      "terrain": "red",
      "name": {
        "zh": "红道平整雪道",
        "en": "Red piste"
      },
      "desc": {
        "zh": "更陡的平整道，适合中小弯卡宾启发式。",
        "en": "Steeper groomed red; for medium and short carve heuristics."
      },
      "tips": {
        "zh": "先在蓝道能倾再上红道；累了换缓坡。",
        "en": "Incline on blue before red; move easier when form fades."
      }
    },
    "venue_black_steep": {
      "id": "venue_black_steep",
      "terrain": "black",
      "name": {
        "zh": "黑色陡坡",
        "en": "Black steep"
      },
      "desc": {
        "zh": "仅在蘑菇落差线课使用的陡/难建议，仍非实测。",
        "en": "Steep/hard suggestion for fall-line moguls only; still not measured."
      },
      "tips": {
        "zh": "包圆、线空、能看到沟；不要为了黑道硬上。",
        "en": "Round bumps, an open line, visible troughs; do not force a black run."
      }
    },
    "venue_mogul_field": {
      "id": "venue_mogul_field",
      "terrain": "mogul",
      "name": {
        "zh": "蘑菇区",
        "en": "Mogul field"
      },
      "desc": {
        "zh": "圆而浅的包，先直滑吸收。",
        "en": "Round, shallow bumps; absorb in a straight line first."
      },
      "tips": {
        "zh": "避开尖包、跳台和过窄的线。",
        "en": "Avoid sharp bumps, jumps, and a too-narrow line."
      }
    },
    "venue_park": {
      "id": "venue_park",
      "terrain": "park",
      "name": {
        "zh": "公园",
        "en": "Park"
      },
      "desc": {
        "zh": "目录课：箱杆跳台请线下教练，软件不打分。",
        "en": "Catalog: boxes, rails, and jumps with a coach; the app does not score them."
      },
      "tips": {
        "zh": "只在有教练和防护的公园区域尝试。",
        "en": "Only try park features with a coach and protection."
      }
    },
    "venue_dryland": {
      "id": "venue_dryland",
      "terrain": "green",
      "name": {
        "zh": "陆地平坦场地",
        "en": "Dryland / flat"
      },
      "desc": {
        "zh": "室内或平地，练站姿和单腿力量。",
        "en": "Indoors or flat ground for stance and single-leg strength."
      },
      "tips": {
        "zh": "防滑地面，旁边有扶手更好。",
        "en": "Non-slip floor; a handhold nearby helps."
      }
    }
  },
