  "drills": {
    "drill_film": {
      "id": "drill_film",
      "name": {
        "zh": "拍摄说明",
        "en": "How to film"
      },
      "desc": {
        "zh": "画面稳、一人、侧或斜后，才能判定阶段。",
        "en": "Stable follow-cam, one skier, side or rear-quarter."
      },
      "training": [
        {
          "zh": "跟拍手机，画面尽量只框一名双板滑者。",
          "en": "Follow-cam; one alpine skier in frame."
        },
        {
          "zh": "从侧面或斜后方拍完整段，少遮挡、光线足够。",
          "en": "Side or rear-quarter, whole run, little occlusion."
        },
        {
          "zh": "不要边滑边剧烈甩镜头，否则阶段无法判定。",
          "en": "Avoid wild camera motion or the stage cannot be judged."
        }
      ],
      "venue_ids": [
        "venue_green_groomer"
      ]
    },
    "drill_land_stance": {
      "id": "drill_land_stance",
      "name": {
        "zh": "陆上运动站姿",
        "en": "Athletic stance on land"
      },
      "desc": {
        "zh": "踝膝髋微屈，重心在脚心，不后坐。",
        "en": "Soft ankles, knees, and hips; center of mass over mid-foot."
      },
      "training": [
        {
          "zh": "标准：侧面看髋在踝上方，膝不锁死。",
          "en": "Standard: hip over ankle in profile; knees unlocked."
        },
        {
          "zh": "3 组 × 30 秒，不许塌腰后坐。",
          "en": "3×30s; no collapsed backseat."
        }
      ],
      "venue_ids": [
        "venue_dryland"
      ]
    },
    "drill_land_squat": {
      "id": "drill_land_squat",
      "name": {
        "zh": "深蹲与分腿蹲",
        "en": "Squats and split squats"
      },
      "desc": {
        "zh": "练独立压腿，为半犁收板和卡宾外侧腿做准备。",
        "en": "Single-leg strength for the christie close and carve outside ski."
      },
      "training": [
        {
          "zh": "标准：膝沿脚尖，骨盆不左右倾倒。",
          "en": "Standard: knees track over the toes; pelvis level."
        },
        {
          "zh": "双腿深蹲 3×8；保加利亚分腿蹲每侧 3×6。",
          "en": "3×8 squats; Bulgarian split squat 3×6 each side."
        }
      ],
      "venue_ids": [
        "venue_dryland"
      ]
    },
    "drill_wedge_stop": {
      "id": "drill_wedge_stop",
      "name": {
        "zh": "缓坡犁式制动",
        "en": "Gentle-slope wedge brake"
      },
      "desc": {
        "zh": "用开角和立刃把速度关死，不靠摔倒。",
        "en": "Open the tails and edge to a stop; do not sit down."
      },
      "training": [
        {
          "zh": "标准：十次停下板头始终相对、上身对山下。",
          "en": "Standard: ten stops, tips close, torso facing downhill."
        },
        {
          "zh": "绿道犁式直滑，匀速后再推开板尾立刃停下。",
          "en": "Wedge-glide on a green run, then open the tails and edge to a stop."
        }
      ],
      "venue_ids": [
        "venue_green_groomer"
      ]
    },
    "drill_wedge_c": {
      "id": "drill_wedge_c",
      "name": {
        "zh": "犁式浅弧 C 弯",
        "en": "Shallow wedge C-turns"
      },
      "desc": {
        "zh": "在仍能刹车的前提下划浅 C，外侧板承重。",
        "en": "Shallow C-turns while the wedge still brakes; load the outside ski."
      },
      "training": [
        {
          "zh": "标准：连续 S 迹，不冲道边；弯中犁式不消失。",
          "en": "Standard: linked S-track, no dart to the edge; the wedge stays through the turn."
        },
        {
          "zh": "斜滑降开始，外侧加压划小 C，再换另一侧。",
          "en": "From a traverse, pressure the outside ski through a small C, then switch sides."
        }
      ],
      "venue_ids": [
        "venue_green_groomer"
      ]
    },
    "drill_hip_steer": {
      "id": "drill_hip_steer",
      "name": {
        "zh": "髋内旋导向",
        "en": "Hip internal-rotation steering"
      },
      "desc": {
        "zh": "用腿和髋改变板向，肩不要当方向盘。",
        "en": "Legs and hips steer; do not use the shoulders as a steering wheel."
      },
      "training": [
        {
          "zh": "标准：板开始转时肩仍大体对山下。",
          "en": "Standard: the skis start to turn while the shoulders still face downhill."
        },
        {
          "zh": "陆上模拟：微屈站，左右髋内旋带动脚尖，肩不动。",
          "en": "On land: athletic stance, rotate the femurs to turn the toes, keep the shoulders still."
        }
      ],
      "venue_ids": [
        "venue_green_groomer",
        "venue_dryland"
      ]
    },
    "drill_christie": {
      "id": "drill_christie",
      "name": {
        "zh": "出弯收内侧板",
        "en": "Close the inside ski"
      },
      "desc": {
        "zh": "入弯犁、出弯逐渐并板，禁止突然并死。",
        "en": "Wedge to start, gradually match at the finish; do not snap shut."
      },
      "training": [
        {
          "zh": "标准：出弯后半段站距变小，但不失稳。",
          "en": "Standard: stance narrows in the last third of the turn, still stable."
        },
        {
          "zh": "绿/蓝道做 8 个弯，只在出弯收板。",
          "en": "Eight turns on green or blue; close the ski only at the finish."
        }
      ],
      "venue_ids": [
        "venue_green_groomer",
        "venue_blue_groomer"
      ]
    },
    "drill_hands": {
      "id": "drill_hands",
      "name": {
        "zh": "手低点杖节奏",
        "en": "Low hands and pole rhythm"
      },
      "desc": {
        "zh": "杖尖低、手在视野前下方，给左右节拍。",
        "en": "Pole tips low; hands in the lower visual field for left-right timing."
      },
      "training": [
        {
          "zh": "标准：回放里手腕不高于肩。",
          "en": "Standard: on replay, the wrists stay below the shoulders."
        },
        {
          "zh": "缓坡平行或犁式，每弯轻点山下杖。",
          "en": "Easy slope, parallel or wedge: tap the downhill pole each turn."
        }
      ],
      "venue_ids": [
        "venue_green_groomer",
        "venue_blue_groomer"
      ]
    },
    "drill_hockey": {
      "id": "drill_hockey",
      "name": {
        "zh": "冰球刹",
        "en": "Hockey stop"
      },
      "desc": {
        "zh": "平行板横切急停，搓雪小弯的必过刹车。",
        "en": "Matched-ski sideslip stop; required braking for short skidded turns."
      },
      "training": [
        {
          "zh": "标准：左右都能停在预定点，板平行、不犁开。",
          "en": "Standard: stop on a mark both ways; skis parallel, not in a wedge."
        },
        {
          "zh": "绿道斜滑降，点杖后双板同时横过来立刃停下。",
          "en": "From a green-run traverse, plant, match both skis, and edge to a stop."
        },
        {
          "zh": "每侧 8 次；速度一起来先回到斜滑再刹。",
          "en": "Eight each side; if speed builds, reset to a traverse before stopping."
        }
      ],
      "venue_ids": [
        "venue_green_groomer",
        "venue_blue_groomer"
      ]
    },
    "drill_skid_short": {
      "id": "drill_skid_short",
      "name": {
        "zh": "搓雪小弯节奏",
        "en": "Short skidded-turn rhythm"
      },
      "desc": {
        "zh": "平行板快速左右转换控速，允许刃搓混合。",
        "en": "Linked short skids on parallel skis; mixed edge and skid is acceptable."
      },
      "training": [
        {
          "zh": "标准：弯与弯之间没有长横切；膝有屈伸。",
          "en": "Standard: no long traverse between turns; knees flex and extend."
        },
        {
          "zh": "蓝道平整处 10 个短弯一组，肩静手低。",
          "en": "Ten short turns on a blue groomer; quiet shoulders, hands low."
        }
      ],
      "venue_ids": [
        "venue_blue_groomer"
      ]
    },
    "drill_one_ski": {
      "id": "drill_one_ski",
      "name": {
        "zh": "单脚滑 / 外侧腿",
        "en": "One-ski / outside-leg drill"
      },
      "desc": {
        "zh": "卡宾前先能把重量放在一条腿上。",
        "en": "Own one-legged balance before carving."
      },
      "training": [
        {
          "zh": "标准：缓坡外侧板滑一段，内侧板轻点雪不承重。",
          "en": "Standard: glide on the outside ski; the inside ski taps the snow without taking weight."
        },
        {
          "zh": "每侧 6 次斜滑降；失稳就放回双脚，不要硬撑。",
          "en": "Six traverses per side; put the ski down if you wobble."
        }
      ],
      "venue_ids": [
        "venue_green_groomer",
        "venue_blue_groomer"
      ]
    },
    "drill_carve_round": {
      "id": "drill_carve_round",
      "name": {
        "zh": "大弯走圆",
        "en": "Round long-radius turns"
      },
      "desc": {
        "zh": "把弯做圆，让板有机会走刃（启发式，非 FIS）。",
        "en": "Round the turn so the ski can bend (heuristic, not FIS)."
      },
      "training": [
        {
          "zh": "标准：髋向弯心倾，肩不甩；站距保持平行。",
          "en": "Standard: hips incline into the turn, shoulders quiet, stance parallel."
        },
        {
          "zh": "中等坡画 6 个大 C，外侧腿更长。",
          "en": "Six large C-turns on a moderate pitch; longer outside leg."
        }
      ],
      "venue_ids": [
        "venue_blue_groomer"
      ]
    },
    "drill_carve_medium": {
      "id": "drill_carve_medium",
      "name": {
        "zh": "中弯换刃",
        "en": "Medium-radius edge change"
      },
      "desc": {
        "zh": "在大弯能倾之后缩短半径。",
        "en": "Shorten the radius only after long-radius inclination works."
      },
      "training": [
        {
          "zh": "标准：换刃点清楚，不直立横刮。",
          "en": "Standard: a clear edge change, not an upright scrape."
        },
        {
          "zh": "同一坡面 8 个中弯，频率高于大弯、低于小弯。",
          "en": "Eight medium turns on the same pitch; cadence between long and short."
        }
      ],
      "venue_ids": [
        "venue_red_piste"
      ]
    },
    "drill_carve_short": {
      "id": "drill_carve_short",
      "name": {
        "zh": "短半径卡宾节奏",
        "en": "Short-radius carve cadence"
      },
      "desc": {
        "zh": "快换刃但平行与内倾不能丢。",
        "en": "Faster edge changes without losing parallel inclination."
      },
      "training": [
        {
          "zh": "标准：左右对称，肩更静。",
          "en": "Standard: left-right symmetry, even quieter shoulders."
        },
        {
          "zh": "组数少、质量高，避免以疲劳换变形。",
          "en": "Few high-quality sets; do not train fatigue into poor form."
        }
      ],
      "venue_ids": [
        "venue_red_piste"
      ]
    },
    "drill_mogul_absorb": {
      "id": "drill_mogul_absorb",
      "name": {
        "zh": "单包吸收",
        "en": "Single-mogul absorption"
      },
      "desc": {
        "zh": "包顶变短、沟槽变高，用腿贴雪，不要跳。",
        "en": "Shorten at the crest, lengthen in the trough; stay on snow, do not jump."
      },
      "training": [
        {
          "zh": "标准：上身相对静，膝屈振幅大，落地不砸直腿。",
          "en": "Standard: quiet torso, large knee travel, no straight-leg slam."
        },
        {
          "zh": "选圆而浅的包沿沟直滑 8 次。",
          "en": "Eight straight lines over round, shallow bumps."
        }
      ],
      "venue_ids": [
        "venue_mogul_field"
      ]
    },
    "drill_mogul_line": {
      "id": "drill_mogul_line",
      "name": {
        "zh": "沟槽落差线",
        "en": "Trough fall-line rhythm"
      },
      "desc": {
        "zh": "少横切，连续吸收，仍不开空中评分。",
        "en": "Fewer traverses, linked absorption; still no air scoring."
      },
      "training": [
        {
          "zh": "标准：髋横摆相对高度变化不大，膝仍在做功。",
          "en": "Standard: hips stay near the fall line; the knees still do the work."
        },
        {
          "zh": "八到十二个包一组，累了就停。",
          "en": "Sets of 8–12 bumps; stop when form fades."
        }
      ],
      "venue_ids": [
        "venue_mogul_field",
        "venue_black_steep"
      ]
    }
  },
  "checkpoints": {
    "cp_pg_stance": {
      "id": "cp_pg_stance",
      "name": {
        "zh": "犁式站距",
        "en": "Wedge stance"
      },
      "desc": {
        "zh": "板头近、板尾开，站距宽于髋。",
        "en": "Tips close, tails open, stance wider than the hips."
      },
      "body": [
        "ankle",
        "knee",
        "hip"
      ],
      "required": true,
      "signal": "stance_width",
      "threshold": {
        "op": "between",
        "value": 1.15,
        "hi": 2.5
      },
      "heuristic_not_fis_carve": false,
      "drills": [
        "drill_wedge_stop"
      ]
    },
    "cp_pg_knee": {
      "id": "cp_pg_knee",
      "name": {
        "zh": "膝踝微屈",
        "en": "Soft knees and ankles"
      },
      "desc": {
        "zh": "膝踝有弹性，不锁直。",
