{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visual.local/schemas/core-inference.v0.json",
  "title": "CoreInferenceResultV0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "frame", "detections", "poses", "tracks", "classifications", "segments", "model_meta"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "timestamp_ms", "width", "height"],
      "properties": {
        "source_kind": { "enum": ["image", "video_frame"] },
        "timestamp_ms": { "type": "number" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "camera_intrinsics": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "fx": { "type": "number" },
            "fy": { "type": "number" },
            "cx": { "type": "number" },
            "cy": { "type": "number" }
          }
        }
      }
    },
    "detections": {
      "type": "array",
      "items": { "$ref": "#/$defs/detection" }
    },
    "poses": {
      "type": "array",
      "items": { "$ref": "#/$defs/pose" }
    },
    "tracks": {
      "type": "array",
      "items": { "$ref": "#/$defs/track" }
    },
    "classifications": { "type": "array", "items": { "$ref": "#/$defs/classification" } },
    "segments": { "type": "array", "items": { "$ref": "#/$defs/segment" } },
    "model_meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend_id", "model_name", "latency_ms", "device"],
      "properties": {
        "backend_id": {
          "type": "string",
          "description": "yolo11n-pose | yolo11n | mediapipe_pose"
        },
        "model_name": { "type": "string" },
        "latency_ms": { "type": "number" },
        "device": { "type": "string" }
      }
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": ["NO_PERSON", "LOW_CONFIDENCE", "GPU_OOM", "INVALID_INPUT"]
        },
        "message": { "type": "string" }
      }
    }
  },
  "$defs": {
    "xyxy": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number" }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class_name", "confidence", "bbox_xyxy"],
      "properties": {
        "class_name": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "bbox_xyxy": { "$ref": "#/$defs/xyxy" },
        "track_id": { "type": ["integer", "null"] }
      }
    },
    "keypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "x", "y", "confidence"],
      "properties": {
        "name": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": ["number", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "pose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skeleton", "keypoints", "score"],
      "properties": {
        "skeleton": { "enum": ["coco_17"] },
        "keypoints": {
          "type": "array",
          "minItems": 17,
          "maxItems": 17,
          "items": { "$ref": "#/$defs/keypoint" }
        },
        "score": { "type": "number" },
        "detection_index": { "type": ["integer", "null"] }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track_id", "detection_index"],
      "properties": {
        "track_id": { "type": "integer" },
        "detection_index": { "type": "integer" }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class_name", "confidence"],
      "properties": {
        "class_name": { "type": "string" },
        "confidence": { "type": "number" }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class_name", "confidence", "rle"],
      "properties": {
        "class_name": { "type": "string" },
        "confidence": { "type": "number" },
        "rle": { "type": "string" }
      }
    }
  }
}
